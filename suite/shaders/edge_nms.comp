#version 450
// compute.edge kind=sobel Stage 2: 3x3 directional Non-Maximum Suppression + dual threshold.
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, set = 0, binding = 0) readonly buffer Grad { uint grad[]; };
layout(std430, set = 0, binding = 1) readonly buffer Mag { uint mag[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Out { uint dst[]; };
layout(push_constant) uniform PC { int w; int h; } pc;

shared uint tile[18][18];

void main()
{
   int lx = int(gl_LocalInvocationID.x);
   int ly = int(gl_LocalInvocationID.y);
   int bx = int(gl_WorkGroupID.x * 16u) - 1;
   int by = int(gl_WorkGroupID.y * 16u) - 1;
   uint lid = gl_LocalInvocationIndex;
   for (uint i = lid; i < 324u; i += 256u) {
      int tx = int(i % 18u);
      int ty = int(i / 18u);
      int sx = clamp(bx + tx, 0, pc.w - 1);
      int sy = clamp(by + ty, 0, pc.h - 1);
      tile[ty][tx] = mag[sy * pc.w + sx];
   }
   barrier();

   int x = int(gl_GlobalInvocationID.x);
   int y = int(gl_GlobalInvocationID.y);
   if (x >= pc.w || y >= pc.h)
      return;

   int idx = y * pc.w + x;
   uint g = grad[idx];
   int gx = int(g & 0xfffu) - 2048;
   int gy = int((g >> 12u) & 0xfffu) - 2048;
   int ax = abs(gx), ay = abs(gy);
   uint m = tile[ly + 1][lx + 1];
   uint n1, n2;
   if (ax >= 2 * ay) {
      n1 = tile[ly + 1][lx + 0]; n2 = tile[ly + 1][lx + 2];
   } else if (ay >= 2 * ax) {
      n1 = tile[ly + 0][lx + 1]; n2 = tile[ly + 2][lx + 1];
   } else if ((gx ^ gy) >= 0) {
      n1 = tile[ly + 0][lx + 0]; n2 = tile[ly + 2][lx + 2];
   } else {
      n1 = tile[ly + 0][lx + 2]; n2 = tile[ly + 2][lx + 0];
   }
   uint kept = (m >= n1 && m >= n2) ? m : 0u;
   dst[idx] = kept >= 180u ? 255u : (kept >= 90u ? 128u : 0u);
}
